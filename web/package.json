{
  "name": "sengoku-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "sengoku-mcp の自国の状況を日本地図で表示するブラウザアプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api-server/openapi.json -o src/api/schema.d.ts",
    "gen:map": "node scripts/build-japan-map.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "d3-geo": "^3.1.1",
    "jsdom": "^27.0.0",
    "mapshaper": "^0.6.113",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.19.0"
}
